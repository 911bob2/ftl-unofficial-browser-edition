@model bool
<section id="local-assets" class="resource-card" hidden aria-label="Game file">
    <h2>Game file</h2>
    <p data-local-intro class="muted">Choose <strong>ftl.dat</strong> from FTL 1.6.14. It is kept in this browser.</p>
    <label data-local-drop class="file-drop"><span class="file-drop-icon" aria-hidden="true">↥</span><strong>Choose your ftl.dat</strong><span class="muted">or drop the file here</span><input type="file" accept=".dat,application/octet-stream" aria-label="Choose your ftl.dat"></label>
    <p data-local-status role="status" aria-live="polite">Checking browser storage…</p>
    <div class="actions"><button data-local-cancel class="btn btn-sm" hidden>Cancel</button><button data-local-session class="btn btn-primary btn-sm" hidden>Use for this session</button><button data-local-remove class="btn btn-ghost btn-sm" hidden>Remove ftl.dat</button></div>
</section>
