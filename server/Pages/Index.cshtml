@page
@inject Ftl.Server.ClientAssets ClientAssets
@inject Ftl.Server.OnboardingCookies Onboarding
@inject Ftl.Server.RegistrationPolicy Registration
@inject Ftl.Server.GameDatabase Db
@{
    var player = HttpContext.Items["Player"] as Ftl.Server.Player;
    var signed = User.Identity?.IsAuthenticated == true && player != null;
    var view = Request.Query["view"].ToString();
    // The first screen is decided here, from the long-lived consent and mode cookies, so nothing flashes.
    var consented = Onboarding.Consented(Request);
    var mode = signed ? "cloud" : Onboarding.Mode(Request);
    var localMode = !signed && consented && mode == "local";
    var registrationOpen = await Registration.OpenAsync(Db);
    var role = Ftl.Server.AccountRoles.Role(HttpContext);
    string initial;
    if (view == "about") initial = "about-panel";
    else if (!consented) initial = "consent-panel";
    else if (signed) initial = player!.MustChangePassword ? "password-panel" : view switch {
        "account" => "account-panel", "saves" => "saves-panel", "logs" => "logs-panel",
        "users" when Ftl.Server.AccountRoles.Admin(HttpContext) => "admin-panel", _ => "launch-panel"
    };
    else if (view == "register") initial = "register-panel";
    else if (view == "signin") initial = "login-panel";
    else if (mode == "local") initial = view switch { "saves" => "saves-panel", "logs" => "logs-panel", _ => "launch-panel" };
    else if (mode == "cloud") initial = "login-panel";
    else initial = "mode-panel";
}
<!doctype html>
<html lang="en" data-theme="ftl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FTL: Unofficial Browser Edition</title><link rel="stylesheet" href="/web/style.css?v=@ClientAssets.Version"></head>
<body class="site-page bg-base-200 text-base-content" data-panel="@initial" data-consent="@(consented ? "1" : "0")" data-mode="@mode" data-auth-state="@(signed ? player!.MustChangePassword ? "password-required" : "authenticated" : localMode ? "local" : "signed-out")" data-account="@player?.Id" data-role="@(localMode ? "local" : role)">
@await Html.PartialAsync("Shared/_ShellHeader")
@await Html.PartialAsync("Shared/_FtlBanner")
<main class="site-main"><section id="checking-panel" class="panel narrow" hidden><span class="loading-ring" aria-hidden="true"></span><h1>Connecting to your account</h1><p id="checking-message" role="status">Checking your session…</p><button id="session-retry" class="btn" hidden>Retry connection</button></section>
<section id="consent-panel" class="welcome-screen" hidden="@(initial == "consent-panel" ? null : "hidden")">
<div class="panel welcome-card"><span class="panel-tab">Notice</span><h1>Unofficial fan project</h1>
<p class="welcome-lead">Not made, endorsed or supported by Subset Games. FTL: Faster Than Light belongs to Subset Games.</p>
<div class="welcome-actions"><button id="consent-agree" class="btn btn-primary btn-lg" type="button">Agree</button></div>
<p class="signin-note muted"><a href="/?view=about" class="text-action" data-view="about">About and licenses</a></p></div></section>
<section id="mode-panel" class="welcome-screen" hidden="@(initial == "mode-panel" ? null : "hidden")">
<div class="mode-heading"><h1>Choose how to save</h1><p class="muted">Both use your own ftl.dat.</p></div>
<div class="mode-grid">
<div class="panel mode-card"><span class="panel-tab">Account</span><h2>Cloud saves</h2><ul class="plain-list"><li>Username and password.</li><li>Saves on the server, on any device.</li></ul><button id="mode-cloud" class="btn btn-primary btn-lg" type="button">Use cloud saves</button></div>
<div class="panel mode-card"><span class="panel-tab">No account</span><h2>Local only</h2><ul class="plain-list"><li>No account.</li><li>Saves in this browser only. Clearing browser data deletes them.</li></ul><button id="mode-local" class="btn btn-lg" type="button">Play local only</button></div>
</div></section>
<section id="register-panel" class="landing-grid" hidden="@(initial == "register-panel" ? null : "hidden")">
<div class="panel signin-card"><span class="panel-tab">New account</span><h1>Create account</h1>
<p id="register-closed" class="alert" role="status" hidden="@(registrationOpen ? "hidden" : null)">Registration is closed on this server. Ask the administrator for an account, or play local only.</p>
<div id="register-open" hidden="@(registrationOpen ? null : "hidden")">
<form id="register-form"><label>Username<input class="input w-full" name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_\-]{3,32}" placeholder="3 to 32 letters, digits, _ or -"></label><label>Password<input class="input w-full" name="password" type="password" autocomplete="new-password" required minlength="15" maxlength="128" placeholder="15 to 128 characters"></label><label>Confirm password<input class="input w-full" name="confirm" type="password" autocomplete="new-password" required minlength="15" maxlength="128" placeholder="Repeat the password"></label><button class="btn btn-primary" type="submit">Create account</button></form></div>
<p class="signin-note muted"><a id="register-signin" href="/?view=signin" class="text-action">I already have an account</a><button id="register-back" type="button" class="text-action link-button">Back</button></p></div></section>
<section id="login-panel" class="landing-grid" hidden="@(initial == "login-panel" ? null : "hidden")">
<div class="panel signin-card"><span class="panel-tab">Account access</span><h1>Sign in</h1><form id="login-form"><label>Username<input class="input w-full" name="username" autocomplete="username" required maxlength="64" placeholder="Your username"></label><label>Password<input class="input w-full" name="password" type="password" autocomplete="current-password" required maxlength="128" placeholder="Your password"></label><button class="btn btn-primary" type="submit">Sign in</button></form><p class="signin-note muted"><a id="login-register" href="/?view=register" class="text-action" hidden="@(registrationOpen ? null : "hidden")">Create an account</a><span id="login-closed" hidden="@(registrationOpen ? "hidden" : null)">Registration is closed. Ask the administrator for an account.</span><button id="play-local" type="button" class="text-action link-button">Play local only</button></p></div></section>
<section id="password-panel" class="panel narrow" hidden="@(initial == "password-panel" ? null : "hidden")"><h1>Change password</h1><p class="muted mb-4">Use 15 to 128 characters.</p><form id="password-form"><label>Current password<input class="input w-full" name="current" type="password" autocomplete="current-password" required maxlength="128"></label><label>New password<input class="input w-full" name="next" type="password" autocomplete="new-password" minlength="15" maxlength="128" required></label><label>Confirm new password<input class="input w-full" name="confirm" type="password" autocomplete="new-password" minlength="15" maxlength="128" required></label><button class="btn btn-primary">Change password</button></form><button class="btn btn-ghost close-panel mt-4">Back</button></section>
<section id="launch-panel" class="launch-dashboard" hidden="@(initial == "launch-panel" ? null : "hidden")"><div class="panel launch-hero"><span class="panel-tab">Play</span><div class="launch-copy"><h1>Faster Than Light</h1><p id="resource-ready" class="resource-ready"><i class="status-dot" aria-hidden="true"></i>Checking game resources…</p><p id="cloud-ready" class="muted" role="status">Checking your save…</p></div><div class="launch-actions"><button id="launch" class="btn btn-primary btn-lg" disabled="@(role == "external-user" || localMode ? "disabled" : null)">Launch FTL</button><button id="launch-tests" class="btn" hidden="@(localMode ? "hidden" : null)">Tests &amp; benchmarks</button><button id="takeover" class="btn" hidden>Take over from another device</button></div></div>
<div id="play-assets">@await Html.PartialAsync("Shared/_LocalAssets", localMode)</div></section>
<section id="game-panel" hidden="@(initial == "game-panel" ? null : "hidden")"><div id="game-container" class="game-container"><div class="gamebar"><span id="save-status" role="status">Loading…</span><div><span id="debug-indicator" class="badge badge-error" hidden>Recording</span><label class="flex items-center gap-2 text-sm"><input id="game-debug" type="checkbox" class="checkbox checkbox-sm">Debug logging</label><button id="debug-mark" class="btn btn-sm">Mark issue</button><button id="console" class="btn btn-sm">Console</button><button id="save" class="btn btn-sm">Save</button><button id="fullscreen" class="btn btn-sm">Fullscreen</button><button id="hide-header" class="btn btn-sm" hidden>Hide header</button><button id="save-close" class="btn btn-sm">Save and close</button></div></div><button id="show-header" class="show-header" type="button" aria-label="Show header" hidden></button><div id="game-loading" class="game-loading"><span class="loading-ring" aria-hidden="true"></span><p id="loading-phase" role="status">Loading game resources…</p></div><canvas id="game" width="1280" height="720" tabindex="0" aria-label="FTL game"></canvas><div id="connection-panel" class="panel" hidden><h2>Game paused</h2><p id="connection-message"></p><button id="reconnect" class="btn">Reconnect and synchronize</button><button id="recovery-export" class="btn">Download pending progress</button></div></div></section>
<section id="account-panel" class="panel" hidden="@(initial == "account-panel" ? null : "hidden")"><h1>Account</h1><p id="account-summary" class="muted"></p>
<div class="subcard"><h2>Password</h2><p class="muted">Changing it signs you out on every device.</p><div class="actions"><button id="change-password" class="btn">Change password</button></div></div>
<div id="account-assets"></div>
<div id="delete-zone" class="danger-zone"><h2>Delete account</h2><p>Permanent and cannot be undone. Erases your account, cloud save, recovery snapshots and logs on the server, and the ftl.dat cached in this browser.</p><div class="actions"><button id="delete-backup" type="button" class="btn btn-sm">Download my save backup first</button></div><form id="delete-account-form"><label>Current password<input id="delete-password" class="input w-full" name="password" type="password" autocomplete="current-password" required maxlength="128"></label><button id="delete-account" class="btn btn-error" type="submit">Delete account permanently</button></form><p id="delete-blocked" class="muted" role="status" hidden>You are the final enabled administrator. Create or enable another administrator before deleting this account.</p></div>
<button class="btn btn-ghost close-panel mt-4">Back</button></section>
<section id="saves-panel" class="panel" hidden="@(initial == "saves-panel" ? null : "hidden")"><h1>Saves</h1><div class="actions"><button id="backup-download" class="btn">@(localMode ? "Download local save" : "Download cloud save")</button><label class="btn file-button">Import save<input id="backup-import" type="file" accept="application/json,.json"></label><button id="snapshots-refresh" class="btn">Recovery snapshots</button></div><div id="snapshots" class="snapshot-list"><p class="muted">Recovery snapshots retain your ten most recent saves.</p></div>
<div id="local-save-card" class="subcard" hidden><h2>Save in this browser</h2><p id="local-save-info" class="muted" role="status"></p><div class="actions"><button id="local-save-move" type="button" class="btn btn-primary btn-sm">Move to this account</button><button id="local-save-download" type="button" class="btn btn-sm">Download backup</button><button id="local-save-remove" type="button" class="btn btn-ghost btn-sm">Remove from this browser</button></div></div>
<div id="storage-card" class="subcard" hidden><h2>Browser storage</h2><p id="storage-status" class="muted" role="status"></p></div>
<button class="btn btn-ghost close-panel mt-4">Back</button></section>
<section id="logs-panel" class="panel" hidden="@(initial == "logs-panel" ? null : "hidden")"><h1>Logs</h1><div class="actions items-center"><label class="flex items-center gap-2"><input id="debug-enabled" type="checkbox" class="checkbox">Enable debug logging</label><span id="debug-status" class="text-sm" role="status">Stopped</span><button id="debug-stop" class="btn btn-sm">Stop</button><button id="logs-mark" class="btn btn-sm">Mark issue</button></div><p id="log-usage" class="text-sm"></p><div class="actions"><button id="logs-refresh" class="btn btn-sm">Refresh</button><button id="logs-delete" class="btn btn-sm">Delete selected</button><button id="logs-delete-all" class="btn btn-sm">Delete all logs</button></div><div class="overflow-x-auto"><table class="table"><thead><tr><th scope="col">Select</th><th scope="col">Started</th><th scope="col">Status</th><th scope="col">Build</th><th scope="col">Size</th><th scope="col">Errors</th><th scope="col">Actions</th></tr></thead><tbody id="log-sessions"></tbody></table></div><div id="log-detail" hidden class="mt-6"><h2>Session records</h2><form id="log-filter" class="inline actions"><label>Search<input id="log-search" class="input input-sm" placeholder="Event, issue marker, or text"></label><label>Subsystem<input id="log-category" class="input input-sm" placeholder="All"></label><label>Severity<select id="log-severity" class="select select-sm"><option value="">All</option><option>info</option><option>warn</option><option>error</option></select></label><label>From<input id="log-from" type="datetime-local" class="input input-sm"></label><label>To<input id="log-to" type="datetime-local" class="input input-sm"></label><label class="flex items-center gap-2"><input id="log-markers" type="checkbox" class="checkbox checkbox-sm">Issue markers</label><button class="btn btn-sm">Filter</button></form><p id="log-truncation" class="text-sm"></p><pre id="log-records" class="bg-base-200 p-4 text-xs max-h-96 overflow-auto"></pre><button id="log-more" class="btn btn-sm mt-2">More records</button></div><button class="btn btn-ghost close-panel mt-4">Back</button></section>
<section id="admin-panel" class="panel admin-workspace" hidden="@(initial == "admin-panel" ? null : "hidden")"><div class="section-heading"><div><span class="eyebrow">Administration</span><h1>Users</h1></div><span id="users-count" class="badge">Loading…</span></div><div class="subcard registration-setting"><label class="flex items-center gap-2"><input id="registration-toggle" type="checkbox" class="checkbox" disabled>Allow public registration</label><p id="registration-state" class="muted text-sm" role="status">Loading…</p></div><form id="create-user-form" class="create-account"><label>Username<input class="input" name="username" pattern="[a-zA-Z0-9_-]{3,32}" minlength="3" maxlength="32" required placeholder="New account username"></label><label>Account role<select class="select" name="role"><option value="external-user" selected>External user · own game files</option><option value="user">Normal · server game files</option><option value="admin">Admin · full access</option></select></label><button class="btn btn-primary">Create account</button></form><div id="new-credentials" class="credential-card" hidden><div><strong>Temporary sign-in details</strong><p class="muted">Share these securely. A password change is required at first sign-in.</p><pre id="credentials-value"></pre></div><div class="actions"><button id="credentials-copy" class="btn btn-sm">Copy details</button><button id="credentials-dismiss" class="btn btn-ghost btn-sm">Dismiss</button></div></div><div class="user-filters"><label>Search accounts<input id="users-search" class="input input-sm" placeholder="Find a username"></label><label>Role<select id="users-role" class="select select-sm"><option value="">All roles</option><option value="admin">Admin</option><option value="user">Normal</option><option value="external-user">External user</option></select></label><label>Status<select id="users-status" class="select select-sm"><option value="">All statuses</option><option value="active">Active</option><option value="disabled">Disabled</option><option value="deleting">Deletion pending</option></select></label><label>Sort by<select id="users-sort" class="select select-sm"><option value="name">Username</option><option value="created">Newest accounts</option></select></label><button id="users-refresh" class="btn btn-sm">Refresh</button></div><div id="users" class="users-list" aria-live="polite"></div><details class="audit-section"><summary>Security audit</summary><div id="audit" class="audit-list"></div></details></section>
<dialog id="user-dialog" class="user-dialog"><div class="section-heading"><div><span class="eyebrow">Manage account</span><h2 id="user-dialog-title"></h2></div><button id="user-dialog-close" class="btn btn-ghost btn-sm" aria-label="Close account details">✕</button></div><p id="user-dialog-meta" class="muted"></p><form id="role-form" class="subcard"><h3>Account role</h3><label>Role<select id="edit-role" class="select"><option value="external-user">External user</option><option value="user">Normal</option><option value="admin">Admin</option></select></label><p id="role-description" class="muted"></p><button class="btn btn-primary">Save role change</button><p class="muted text-sm">Changing a role signs out existing sessions.</p></form><div class="subcard"><h3>Account security</h3><div id="user-security-actions" class="actions"></div></div><div class="danger-zone"><h3>Delete account</h3><p>Deletes this account, cloud saves, snapshots, and diagnostic logs. Browser-local files and existing operational backups are not remotely erased.</p><p id="user-delete-data" role="status">Loading account data…</p><form id="delete-user-form"><label>Type the exact username<input id="delete-user-confirm" class="input" autocomplete="off" required></label><button class="btn btn-error">Permanently delete account</button></form></div><p id="user-dialog-error" class="alert" role="alert" hidden></p></dialog>
<dialog id="migrate-dialog" class="user-dialog"><div class="section-heading"><div><span class="eyebrow">Local save</span><h2>Move your local save to this account</h2></div><button id="migrate-close" type="button" class="btn btn-ghost btn-sm" aria-label="Close">✕</button></div><p id="migrate-intro" class="muted"></p><div id="migrate-choices" class="subcard"><div class="migrate-compare"><div><h3>Cloud save</h3><p id="migrate-cloud" class="muted"></p><button id="migrate-cloud-download" type="button" class="btn btn-sm">Download cloud backup</button></div><div><h3>Local save</h3><p id="migrate-local" class="muted"></p><button id="migrate-local-download" type="button" class="btn btn-sm">Download local backup</button></div></div></div><div class="actions"><button id="migrate-keep-cloud" type="button" class="btn">Keep cloud save</button><button id="migrate-use-local" type="button" class="btn btn-error">Replace cloud save with local save</button><button id="migrate-confirm" type="button" class="btn btn-primary" hidden>Move local save to account</button></div><p id="migrate-note" class="muted text-sm" role="status"></p></dialog>
<section id="about-panel" class="panel reading-panel" hidden="@(initial == "about-panel" ? null : "hidden")"><h1>About / Licenses</h1><p>FTL © Subset Games. This is an unofficial fan project, not affiliated with Subset Games. It is based on Project Wormhole and Pocket Wormhole.</p><p class="mt-2">Source code under the GNU AGPL v3: <a class="link" href="https://github.com/911bob2/ftl-unofficial-browser-edition">GitHub</a>. Takedown or other requests: <a class="link" href="mailto:ftl@911bob.dev">ftl@911bob.dev</a>.</p><p class="mt-2"><a class="link" href="https://gitlab.com/znixian/xftl">Project Wormhole</a> · <a class="link" href="https://github.com/adamkulik/pocket-wormhole">Pocket Wormhole</a> · <a class="link" href="https://daisyui.com/">daisyUI</a></p><p class="mt-2">Website artwork © Subset Games, from the <a class="link" href="https://subsetgames.com/ftl.html">official FTL website</a>. Display text uses Chakra Petch under the SIL Open Font License.</p><p class="mt-2"><a class="link" href="/Licenses">View license notices</a></p><button class="btn btn-ghost close-panel mt-4">Back</button></section>
<p id="message" class="alert mt-4" role="status" hidden></p>
</main>@await Html.PartialAsync("Shared/_ShellFooter")
<script type="module" src="/web/app.mjs?v=@ClientAssets.Version"></script>
</body></html>
